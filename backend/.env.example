# Salin ke .env untuk konfigurasi lokal. Jangan pernah commit .env atau menempelkan rahasia ke chat/issue.

# development | test | production
STUDYFLOW_APP_ENV=development

# PostgreSQL. Untuk development: `docker compose up -d` lalu pakai URL di bawah.
# Supabase: pakai connection string dari Project Settings > Database (role postgres).
STUDYFLOW_DATABASE_URL=postgresql+psycopg://studyflow:studyflow-dev@localhost:54329/studyflow

# URL proyek Supabase (tanpa /auth/v1). Dipakai untuk issuer JWT dan JWKS (ES256/RS256).
STUDYFLOW_SUPABASE_URL=https://<project-ref>.supabase.co
STUDYFLOW_JWT_AUDIENCE=authenticated
# Hanya untuk proyek yang masih memakai legacy HS256 JWT secret atau untuk tes lokal. Kosongkan jika tidak perlu.
STUDYFLOW_JWT_HS256_SECRET=

# CORS (format JSON). Kosongkan untuk aplikasi native.
STUDYFLOW_CORS_ORIGINS=[]

# Batas sinkronisasi
STUDYFLOW_SYNC_PUSH_MAX_MUTATIONS=100
STUDYFLOW_SYNC_PULL_MAX_LIMIT=500

# ---------- AI ----------
# none              -> fitur AI mengembalikan 503; fitur lain tetap berjalan (default)
# fake              -> output deterministik berlabel [Demo]; ditolak saat APP_ENV=production
# gemini            -> Google Gemini API (direkomendasikan, ada free tier)
# openai_compatible -> API kompatibel OpenAI, mis. Groq (https://api.groq.com/openai/v1)
STUDYFLOW_AI_PROVIDER=none

# Buat API key sendiri di https://aistudio.google.com/apikey lalu isi di bawah. Jangan commit atau tempel ke chat.
# Tanpa key, provider gemini/openai_compatible otomatis dianggap "none".
STUDYFLOW_AI_API_KEY=
# Kosongkan untuk default per provider (gemini: gemini-3.8-flash, openai_compatible: openai/gpt-oss-120b).
STUDYFLOW_AI_MODEL=
STUDYFLOW_AI_BASE_URL=
STUDYFLOW_AI_PROVIDER_LABEL=
# Pemberitahuan sebelum materi dikirim. Kosongkan untuk teks default provider; wajib jujur jika diganti.
# STUDYFLOW_AI_DATA_NOTICE=...

# Batas agar tetap dalam free tier. Batas Gemini free tier per project terlihat di Google AI Studio.
STUDYFLOW_AI_USER_DAILY_LIMIT=10
STUDYFLOW_AI_GLOBAL_DAILY_LIMIT=200
STUDYFLOW_AI_MAX_INPUT_CHARS=12000
STUDYFLOW_AI_MIN_INTERVAL_SECONDS=6
STUDYFLOW_AI_MAX_ATTEMPTS=3
STUDYFLOW_AI_REQUEST_TIMEOUT_SECONDS=60
STUDYFLOW_AI_JOB_LEASE_SECONDS=180
STUDYFLOW_QUIZ_MIN_QUESTIONS=3
STUDYFLOW_QUIZ_MAX_QUESTIONS=10

# ---------- Embedding & tanya materi (fase 4) ----------
# none | fake | gemini. gemini memakai STUDYFLOW_AI_API_KEY jika STUDYFLOW_EMBEDDING_API_KEY kosong.
STUDYFLOW_EMBEDDING_PROVIDER=none
STUDYFLOW_EMBEDDING_API_KEY=
STUDYFLOW_EMBEDDING_MODEL=gemini-embedding-001
# Harus 768 (kolom vector di migrasi 0003). Mengganti model/dimensi berarti reindex.
STUDYFLOW_EMBEDDING_DIM=768
STUDYFLOW_RAG_TOP_K=6
# Kalibrasi dengan: uv run python -m app.eval.rag_eval tests/fixtures/rag_eval.json
STUDYFLOW_RAG_MAX_DISTANCE=0.55

# ---------- Dokumen ----------
# local = folder di disk (development); supabase = bucket privat Supabase Storage.
STUDYFLOW_STORAGE_BACKEND=local
STUDYFLOW_STORAGE_LOCAL_DIR=./.storage
STUDYFLOW_STORAGE_BUCKET=documents
# Secret/service-role key Supabase, hanya untuk backend (storage). Jangan pernah dimasukkan ke aplikasi.
STUDYFLOW_SUPABASE_SERVICE_KEY=
STUDYFLOW_DOCUMENT_MAX_BYTES=10485760
STUDYFLOW_DOCUMENT_MAX_PAGES=100
STUDYFLOW_DOCUMENT_EXTRACT_TIMEOUT_SECONDS=60
STUDYFLOW_CHUNK_WORDS=450
STUDYFLOW_CHUNK_OVERLAP_WORDS=70
STUDYFLOW_INDEX_USER_DAILY_LIMIT=20
STUDYFLOW_INDEX_GLOBAL_DAILY_LIMIT=200

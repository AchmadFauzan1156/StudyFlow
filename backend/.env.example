# Salin ke .env untuk konfigurasi lokal. Jangan pernah commit .env atau menempelkan rahasia ke chat/issue.

# development | test | production
STUDYFLOW_APP_ENV=development

# PostgreSQL. Untuk development: `docker compose up -d` lalu pakai URL di bawah.
# Supabase: pakai connection string dari Project Settings > Database (role postgres).
STUDYFLOW_DATABASE_URL=postgresql+psycopg://studyflow:studyflow-dev@localhost:54329/studyflow

# URL proyek Supabase (tanpa /auth/v1). Dipakai untuk issuer JWT dan JWKS (ES256/RS256).
STUDYFLOW_SUPABASE_URL=https://<project-ref>.supabase.co
STUDYFLOW_JWT_AUDIENCE=authenticated
# Hanya untuk proyek yang masih memakai legacy HS256 JWT secret atau untuk tes lokal. Kosongkan jika tidak perlu.
STUDYFLOW_JWT_HS256_SECRET=

# Provider AI:
#   none -> fitur AI mengembalikan 503; fitur lain tetap berjalan (default)
#   fake -> output deterministik berlabel [Demo]; ditolak saat APP_ENV=production
STUDYFLOW_AI_PROVIDER=none

# Daftar origin CORS dalam format JSON. Kosongkan untuk aplikasi native.
STUDYFLOW_CORS_ORIGINS=[]

# Batas sinkronisasi
STUDYFLOW_SYNC_PUSH_MAX_MUTATIONS=100
STUDYFLOW_SYNC_PULL_MAX_LIMIT=500

# --- Ditambahkan pada fase berikutnya (belum dibaca aplikasi) ---
# STUDYFLOW_AI_MODEL=
# STUDYFLOW_AI_API_KEY=
